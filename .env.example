# ---------------------------------------------------------------------------
# PHILO LAB 환경변수 예시 — 이 파일을 .env.local 로 복사한 뒤 값을 채우세요.
#   cp .env.example .env.local
# .env / .env.local 은 .gitignore 에 포함되어 GitHub 에 올라가지 않습니다.
#
# 값이 비어 있으면 사이트는 "데모 모드"로 동작합니다 (실제 인증 아님, 브라우저에만 저장).
# ---------------------------------------------------------------------------

# Supabase Dashboard → Project Settings → API (Data API) → Project URL
VITE_SUPABASE_URL=

# Supabase Dashboard → Project Settings → API Keys → Publishable key (sb_publishable_...)
#   (구 버전 프로젝트는 anon public key — VITE_SUPABASE_ANON_KEY 이름으로 넣어도 됩니다)
# 이 키는 브라우저에 공개되어도 되는 키이며, 데이터 보호는 DB Row Level Security 가 담당합니다.
VITE_SUPABASE_PUBLISHABLE_KEY=

# ⚠ service_role / secret key 는 절대 여기에 넣지 마세요.
#   학생 계정 생성용 관리자 키는 Supabase Edge Function 실행 환경에만 존재합니다.
